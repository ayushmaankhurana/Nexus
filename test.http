@baseUrl = http://localhost:3000

@pendingRoll = CS21001
@pendingEmail = cs21001@campus.edu
@pendingPassword = pass123
@newActivatedPassword = newpass123
@pendingActivationToken = activation_token_001

@activeRoll = CS21002
@activeEmail = cs21002@campus.edu
### Initial seeded password before running the password reset flow below.
@activePassword = pass123
@resetPasswordNew = newpass456

@deviceA = ios-iphone-15
@deviceB = android-pixel-8
@testStudentId = std_002

@adminRoll = ADM1001
@adminEmail = admin1@campus.edu
@adminPassword = secure123
@adminDevice = macbook-admin-1

@securityRoll = SEC1001
@securityEmail = security1@campus.edu
@securityPassword = secure123
@securityDevice = macbook-security-1

### Live seeded IDs after the latest Prisma reset/seed. Refresh these with psql if you reseed again.
@pendingStudentId = f4fc9f8b-3ee1-40f8-b834-8322eff17bbc
@activeStudentId = ffd4538d-40d2-4bfd-adfa-db2f585b1353
@rohanStudentId = 47d1a2d8-0045-4add-9e07-921e566128fd
@priyaStudentId = 4bacd8ea-63af-4c27-801c-32e80dc263ca
@adminAccountId = 1e838153-4264-4cf7-8efd-6b8f7fb468fc
@securityAccountId = 3acd4339-2b45-4917-95aa-6278e8a59bd8

@mainGateId = 27ac9e6b-84c9-4d04-bc65-a37b06f1d0df
@parkingZoneId = 549633f9-9483-4190-9b93-3fdbd53d4e8f
@cs103LabId = adac6c4a-23cd-4fa8-936f-51cd38284cf3

@anjaliRfid = RFID_B_002
@rohanInvalidRfid = RFID_WRONG_999

### Health
GET {{baseUrl}}/health
Accept: application/json

# ==========================================
# AUTHENTICATION FLOWS
# ==========================================

### 1. Login with active seeded account on device A (CAPTURES JWT & REFRESH TOKEN)
# @name loginRequest
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{activeRoll}}",
  "password": "{{activePassword}}",
  "deviceId": "{{deviceA}}"
}

### Store the tokens globally for protected routes and refresh flows below
@authToken = {{loginRequest.response.body.accessToken}}
@refreshToken = {{loginRequest.response.body.refreshToken}}
@testStudentId = {{loginRequest.response.body.user.id}}
### 2. Login same active account again on device A - should SUCCEED and override (The DX Fix)
# @name loginOverrideRequest
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{activeRoll}}",
  "password": "{{activePassword}}",
  "deviceId": "{{deviceA}}"
}

### Capture the new refresh token from the override
@newRefreshToken = {{loginOverrideRequest.response.body.refreshToken}}

### 3. Refresh Flow (The Vending Machine) - Swap valid refresh token for a new session
# @name refreshSessionRequest
POST {{baseUrl}}/auth/refresh
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{newRefreshToken}}",
  "deviceId": "{{deviceA}}"
}

### 4. Login same active account again on device B - should fail with DEVICE_ALREADY_BOUND
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{activeRoll}}",
  "password": "{{activePassword}}",
  "deviceId": "{{deviceB}}"
}

### 5. Logout active account from device A
POST {{baseUrl}}/auth/logout
Content-Type: application/json
Accept: application/json

{
  "studentId": "{{testStudentId}}",
  "deviceId": "{{deviceA}}"
}

### 6. Login active account again after logout on device B - should now succeed
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{activeEmail}}",
  "password": "{{activePassword}}",
  "deviceId": "{{deviceB}}"
}

### Security login for access-control writer endpoints
# @name securityLoginRequest
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{securityRoll}}",
  "password": "{{securityPassword}}",
  "deviceId": "{{securityDevice}}"
}

@securityToken = {{securityLoginRequest.response.body.accessToken}}

### Admin login for access audit endpoints
# @name adminLoginRequest
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{adminRoll}}",
  "password": "{{adminPassword}}",
  "deviceId": "{{adminDevice}}"
}

@adminToken = {{adminLoginRequest.response.body.accessToken}}

### 7. Device switch active account from device B to device A
POST {{baseUrl}}/auth/device/switch
Content-Type: application/json
Accept: application/json

{
  "studentId": "{{testStudentId}}",
  "oldDeviceId": "{{deviceB}}",
  "newDeviceId": "{{deviceA}}"
}

### Activate pending account
POST {{baseUrl}}/auth/activate
Content-Type: application/json
Accept: application/json

{
  "activationToken": "{{pendingActivationToken}}",
  "password": "{{newActivatedPassword}}"
}

# ==========================================
# PASSWORD RESET FLOWS
# ==========================================

### 1. Request reset token for an existing account
# @name forgotPasswordExisting
POST {{baseUrl}}/auth/password/forgot
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{activeEmail}}"
}

### Store reset token returned for local testing
@passwordResetToken = {{forgotPasswordExisting.response.body.resetToken}}

### After test 2 succeeds, the live password for {{activeEmail}} becomes {{resetPasswordNew}} until changed again.

### 2. Reset password using the generated token
# @name resetPasswordSuccess
POST {{baseUrl}}/auth/password/reset
Content-Type: application/json
Accept: application/json

{
  "resetToken": "{{passwordResetToken}}",
  "newPassword": "{{resetPasswordNew}}"
}

### 3. Login using the new password
# @name loginWithNewPassword
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{activeEmail}}",
  "password": "{{resetPasswordNew}}",
  "deviceId": "{{deviceA}}"
}

### 4. Login using the old password should fail
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{activeEmail}}",
  "password": "{{activePassword}}",
  "deviceId": "{{deviceA}}"
}

### 5. Reuse the same reset token should fail
POST {{baseUrl}}/auth/password/reset
Content-Type: application/json
Accept: application/json

{
  "resetToken": "{{passwordResetToken}}",
  "newPassword": "anotherpassword"
}

### 6. Request reset for a non-existent account
POST {{baseUrl}}/auth/password/forgot
Content-Type: application/json
Accept: application/json

{
  "identifier": "ghost@campus.edu"
}

### 7. Validation error for missing token and short password
POST {{baseUrl}}/auth/password/reset
Content-Type: application/json
Accept: application/json

{
  "resetToken": "",
  "newPassword": "ab"
}

# ==========================================
# PROTECTED ROUTES (Requires @authToken from loginRequest)
# ==========================================

### Students me placeholder
GET {{baseUrl}}/students/me
Authorization: Bearer {{authToken}}
Accept: application/json

### Attendance history placeholder
GET {{baseUrl}}/students/{{testStudentId}}/attendance
Authorization: Bearer {{authToken}}
Accept: application/json

### Mark attendance placeholder
POST {{baseUrl}}/students/{{testStudentId}}/attendance
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "mode": "manual-check",
  "source": "test-http"
}

### Access check should be forbidden for a student token
POST {{baseUrl}}/access/check
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "accountId": "{{activeStudentId}}",
  "geofenceId": "{{mainGateId}}",
  "action": "ENTRY",
  "credentialType": "RFID",
  "credentialValue": "{{anjaliRfid}}"
}

### Student can fetch their own access history through the legacy route
GET {{baseUrl}}/access/{{testStudentId}}
Authorization: Bearer {{authToken}}
Accept: application/json

### Student can fetch their own access history through the new self-service route
GET {{baseUrl}}/access/me/events
Authorization: Bearer {{authToken}}
Accept: application/json

### Student should be forbidden from the global access-events endpoint
GET {{baseUrl}}/access/events
Authorization: Bearer {{authToken}}
Accept: application/json

### Admin can list all access events
GET {{baseUrl}}/access/events?page=1&pageSize=10
Authorization: Bearer {{adminToken}}
Accept: application/json

### Security can record an allowed entry for an active student with a valid RFID
POST {{baseUrl}}/access/check
Authorization: Bearer {{securityToken}}
Content-Type: application/json
Accept: application/json

{
  "accountId": "{{activeStudentId}}",
  "geofenceId": "{{mainGateId}}",
  "action": "ENTRY",
  "credentialType": "RFID",
  "credentialValue": "{{anjaliRfid}}"
}

### Security can record a denied attempt for a pending student
POST {{baseUrl}}/access/check
Authorization: Bearer {{securityToken}}
Content-Type: application/json
Accept: application/json

{
  "accountId": "{{pendingStudentId}}",
  "geofenceId": "{{mainGateId}}",
  "action": "ENTRY",
  "credentialType": "RFID",
  "credentialValue": "RFID_A_001"
}

### Security can record a denied parking attempt for a student
POST {{baseUrl}}/access/check
Authorization: Bearer {{securityToken}}
Content-Type: application/json
Accept: application/json

{
  "accountId": "{{priyaStudentId}}",
  "geofenceId": "{{parkingZoneId}}",
  "action": "ENTRY",
  "credentialType": "MANUAL"
}

### Security can record a denied RFID mismatch attempt
POST {{baseUrl}}/access/check
Authorization: Bearer {{securityToken}}
Content-Type: application/json
Accept: application/json

{
  "accountId": "{{rohanStudentId}}",
  "geofenceId": "{{cs103LabId}}",
  "action": "ENTRY",
  "credentialType": "RFID",
  "credentialValue": "{{rohanInvalidRfid}}"
}

### Presence summary placeholder
GET {{baseUrl}}/presence/{{testStudentId}}
Authorization: Bearer {{authToken}}
Accept: application/json

### Presence trail placeholder
GET {{baseUrl}}/presence/{{testStudentId}}/trail
Authorization: Bearer {{authToken}}
Accept: application/json

### Incidents list placeholder
GET {{baseUrl}}/incidents
Authorization: Bearer {{authToken}}
Accept: application/json

### Create incident placeholder
POST {{baseUrl}}/incidents
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "type": "suspicious-behavior",
  "studentId": "{{testStudentId}}",
  "message": "Manual test incident from REST Client"
}

# ==========================================
# SECURITY / MIDDLEWARE TESTS
# ==========================================

### TEST 1: Missing Token (Should return 401 Unauthorized)
GET {{baseUrl}}/students/{{testStudentId}}/attendance
Accept: application/json

### TEST 2: Wrong Student ID / Ownership Check (Should return 403 Forbidden)
# We are using std_002's token, but asking for std_001's data
GET {{baseUrl}}/students/std_001/attendance
Authorization: Bearer {{authToken}}
Accept: application/json

### TEST 3: Stolen/Used Refresh Token Deny (Should return 401 Unauthorized)
# Trying to use the token that was already swapped out in flow #3
POST {{baseUrl}}/auth/refresh
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{newRefreshToken}}",
  "deviceId": "{{deviceA}}"
}


### Admin login (captures admin JWT)

# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{adminRoll}}",
  "password": "{{adminPassword}}",
  "deviceId": "{{adminDevice}}"
}
### Store admin token for later requests

@adminAuthToken = {{adminLogin.response.body.accessToken}}
@adminStudentId = {{adminLogin.response.body.user.id}}


### Admin creates a new pending student
# @name createStudentSuccess
POST {{baseUrl}}/admin/students
Authorization: Bearer {{adminAuthToken}}
Content-Type: application/json
Accept: application/json

{
  "rollNumber": "CS21005",
  "email": "cs21005@campus.edu",
  "firstName": "Neha",
  "lastName": "Kapoor",
  "rfidTag": "RFID_E_005"
}
### Admin creates a new pending student
@createdStudentActivationToken = {{createStudentSuccess.response.body.activationToken}}
@createdStudentEmail = {{createStudentSuccess.response.body.email}}

### Duplicate roll number should return 409
POST {{baseUrl}}/admin/students
Authorization: Bearer {{adminAuthToken}}
Content-Type: application/json
Accept: application/json

{
  "rollNumber": "CS21005",
  "email": "another-cs21005@campus.edu",
  "firstName": "Duplicate",
  "lastName": "Roll"
}

### Duplicate email should return 409
POST {{baseUrl}}/admin/students
Authorization: Bearer {{adminAuthToken}}
Content-Type: application/json
Accept: application/json

{
  "rollNumber": "CS21006",
  "email": "cs21005@campus.edu",
  "firstName": "Duplicate",
  "lastName": "Email"
}

### Missing token should return 401
POST {{baseUrl}}/admin/students
Content-Type: application/json
Accept: application/json

{
  "rollNumber": "CS21007",
  "email": "cs21007@campus.edu",
  "firstName": "Unauth",
  "lastName": "User"
}

### Student token should return 403
POST {{baseUrl}}/admin/students
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "rollNumber": "CS21008",
  "email": "cs21008@campus.edu",
  "firstName": "Forbidden",
  "lastName": "Student"
}

### Invalid body should return 400
POST {{baseUrl}}/admin/students
Authorization: Bearer {{adminAuthToken}}
Content-Type: application/json
Accept: application/json

{
  "rollNumber": "",
  "email": "not-an-email",
  "firstName": "",
  "lastName": ""
}

### Activate newly created student
POST {{baseUrl}}/auth/activate
Content-Type: application/json
Accept: application/json

{
  "activationToken": "{{createdStudentActivationToken}}",
  "password": "newstudent123"
}

### Login newly created student after activation
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{createdStudentEmail}}",
  "password": "newstudent123",
  "deviceId": "student-device-new-1"
}

