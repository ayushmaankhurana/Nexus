  "accountId": "{{rohanStudentId}}",
  "geofenceId": "{{cs103LabId}}",
  "action": "ENTRY",
  "credentialType": "RFID",
  "credentialValue": "{{rohanInvalidRfid}}"
}

### Student updates their latest location near Main Campus Gate.
### Expected: 200 success; for student tokens the backend ignores body userId and stores against the authenticated account.
POST {{baseUrl}}/presence/update-location
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "userId": "{{pendingStudentId}}",
  "lat": {{mainGateLat}},
  "lng": {{mainGateLng}},
  "timestamp": 1775493000000
}

### Student batch upload appends two more points to their own trail.
### Expected: 200 success even though the body userId is ignored for self-service calls.
POST {{baseUrl}}/presence/batch-upload
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

[
  {
    "userId": "{{pendingStudentId}}",
    "locations": [
      {
        "lat": {{backGateLat}},
        "lng": {{backGateLng}},
        "timestamp": 1775493060000
      },
      {
        "lat": {{mainGateLat}},
        "lng": {{mainGateLng}},
        "timestamp": 1775493120000
      }
    ]
  }
]

### Student stores a BLE detection event.
### Expected: 200 success; event is attributed to the authenticated account and preserves the provided seenBy value.
POST {{baseUrl}}/presence/ble-detection
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "deviceId": "ble-tag-student-1",
  "seenBy": "ios-iphone-15",
  "timestamp": 1775493180000
}

### Legacy presence summary now returns persisted state.
### Expected: 200 with lastSeen populated and isPresent true while the latest timestamp is still within the freshness window.
GET {{baseUrl}}/presence/{{testStudentId}}
Authorization: Bearer {{authToken}}
Accept: application/json

### Legacy presence trail now returns derived checkpoints from stored points.
### Expected: 200 with trail entries including Main Campus Gate / Back Campus Gate checkpoints.
GET {{baseUrl}}/presence/{{testStudentId}}/trail
Authorization: Bearer {{authToken}}
Accept: application/json

### Self-service geofence check uses the authenticated account instead of the body userId.
### Expected: 200 with inside true for Main Campus Gate.
POST {{baseUrl}}/presence/check-geofence
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "userId": "{{pendingStudentId}}",
  "zoneName": "{{mainGateName}}"
}

### Admin can still inspect the raw latest-location alias for another account.
### Expected: 200 with location geofence metadata populated.
GET {{baseUrl}}/presence/current/{{testStudentId}}
Authorization: Bearer {{adminToken}}
Accept: application/json

### Admin can still inspect the raw location-history alias for another account.
### Expected: 200 with stored location points in chronological order.
GET {{baseUrl}}/presence/history/{{testStudentId}}
Authorization: Bearer {{adminToken}}
Accept: application/json

### Incidents list placeholder
GET {{baseUrl}}/incidents
Authorization: Bearer {{authToken}}
Accept: application/json

### Create incident placeholder
POST {{baseUrl}}/incidents
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "type": "suspicious-behavior",
  "studentId": "{{testStudentId}}",
  "message": "Manual test incident from REST Client"
}

