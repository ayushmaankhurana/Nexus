###############################################################################
# NEXUS API TEST SUITE
# File: test.http
# Tool: REST Client extension for VS Code (Extension ID: humao.rest-client)
#
# HOW TO RUN:
#   1. Install the REST Client VS Code extension (humao.rest-client)
#   2. Start the backend: cd backend/api-gateway && npm run dev
#   3. Reset/seed the DB: send the "Demo Reset" request at the bottom first
#   4. Run requests in the MASTER ORDER listed below for least friction
#   5. Click "Send Request" above each ### block to execute it
#
# DYNAMIC VARIABLES:
#   @name <requestName>   — names a request so its response can be referenced
#   {{requestName.response.body.field}}  — reads a field from a named response
#   Variables set with @varName = value  — static variables
#
# SEEDED ACCOUNTS (run demo reset first to restore these):
#   CS21001 / pass123         STUDENT  PENDING  (activation token: activation_token_001)
#   CS21002 / pass123         STUDENT  ACTIVE   (main test account)
#   CS21003–CS21006 / pass123 STUDENT  ACTIVE
#   SEC1001 / secure123       SECURITY ACTIVE
#   ADM1001 / secure123       ADMIN    ACTIVE
#   FAC1001 / secure123       FACULTY  ACTIVE   (Dr. Neha Kapoor, CS dept)
#
# NOTE: Password reset and activation token values are printed to the
#       backend server console (not returned in API responses).
###############################################################################

### MASTER ORDER
# Run this file in this order for the least friction:
# 1. Health.
# 2. Login requests only: active student loginRequest, securityLoginRequest, adminLoginRequest, facultyLoginRequest.
# 3. New attendance flow: attendance/me, adminAttendanceAbsent, facultySessionSummaryBefore, facultyManualExcuse, facultySessionSummaryAfter, then the optional student negative tests.
# 4. Student/admin profile and access tests.
# 5. Admin student-provisioning tests.
# 6. Session mutation tests like logout/device switch.
# 7. Password-reset tests last, because they change the seeded password for CS21002.
# Notes:
# - The new attendance flow assumes the DB was freshly seeded from prisma/seed.ts.
# - If your REST client does not resolve array-based response variables automatically, copy the first row's accountId and classSessionTemplateId from adminAttendanceAbsent into the variables below.

@baseUrl = http://localhost:3000

@pendingRoll = CS21001
@pendingEmail = cs21001@campus.edu
@pendingPassword = pass123
@newActivatedPassword = newpass123
@pendingActivationToken = activation_token_001

@activeRoll = CS21002
@activeEmail = cs21002@campus.edu
### Initial seeded password before running the password reset flow below.
@activePassword = pass123
@resetPasswordNew = newpass456

@deviceA = ios-iphone-15
@deviceB = android-pixel-8
@testStudentId = std_002

@adminRoll = ADM1001
@adminEmail = admin1@campus.edu
@adminPassword = secure123
@adminDevice = macbook-admin-1

@securityRoll = SEC1001
@securityEmail = security1@campus.edu
@securityPassword = secure123
@securityDevice = macbook-security-1

@facultyRoll = FAC1001
@facultyEmail = faculty1@campus.edu
@facultyPassword = secure123
@facultyDevice = macbook-faculty-1

### Used by the new attendance flow below. These should resolve from adminAttendanceAbsent.
@seededAbsentStudentId = {{adminAttendanceAbsent.response.body.data[0].accountId}}
@seededAbsentTemplateId = {{adminAttendanceAbsent.response.body.data[0].classSessionTemplateId}}
@seededAbsentScheduledDate = 2026-04-02

### Live seeded IDs after the latest Prisma reset/seed. Refresh these with psql if you reseed again.
@pendingStudentId = f4fc9f8b-3ee1-40f8-b834-8322eff17bbc
@activeStudentId = ffd4538d-40d2-4bfd-adfa-db2f585b1353
@rohanStudentId = 47d1a2d8-0045-4add-9e07-921e566128fd
@priyaStudentId = 4bacd8ea-63af-4c27-801c-32e80dc263ca
@adminAccountId = 1e838153-4264-4cf7-8efd-6b8f7fb468fc
@securityAccountId = 3acd4339-2b45-4917-95aa-6278e8a59bd8

@mainGateId = 27ac9e6b-84c9-4d04-bc65-a37b06f1d0df
@parkingZoneId = 549633f9-9483-4190-9b93-3fdbd53d4e8f
@cs103LabId = adac6c4a-23cd-4fa8-936f-51cd38284cf3
@mainGateName = Main Campus Gate
@mainGateLat = 28.4089
@mainGateLng = 77.3178
@backGateLat = 28.4081
@backGateLng = 77.3169

@anjaliRfid = RFID_B_002
@rohanInvalidRfid = RFID_WRONG_999

### Health
GET {{baseUrl}}/health
Accept: application/json

# ==========================================
# AUTHENTICATION FLOWS
# ==========================================

### 1. Login with active seeded account on device A (CAPTURES JWT & REFRESH TOKEN)
# @name loginRequest
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{activeRoll}}",
  "password": "{{activePassword}}",
  "deviceId": "{{deviceA}}"
}

### Store the tokens globally for protected routes and refresh flows below
@authToken = {{loginRequest.response.body.accessToken}}
@refreshToken = {{loginRequest.response.body.refreshToken}}
@testStudentId = {{loginRequest.response.body.user.id}}
### 2. Login same active account again on device A - should SUCCEED and override (The DX Fix)
# @name loginOverrideRequest
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{activeRoll}}",
  "password": "{{activePassword}}",
  "deviceId": "{{deviceA}}"
}

### Capture the new refresh token from the override
@newRefreshToken = {{loginOverrideRequest.response.body.refreshToken}}

### 3. Refresh Flow (The Vending Machine) - Swap valid refresh token for a new session
# @name refreshSessionRequest
POST {{baseUrl}}/auth/refresh
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{newRefreshToken}}",
  "deviceId": "{{deviceA}}"
}

### 4. Login same active account again on device B - should fail with DEVICE_ALREADY_BOUND
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{activeRoll}}",
  "password": "{{activePassword}}",
  "deviceId": "{{deviceB}}"
}

### 5. Logout active account from device A
POST {{baseUrl}}/auth/logout
Content-Type: application/json
Accept: application/json

{
  "studentId": "{{testStudentId}}",
  "deviceId": "{{deviceA}}"
}

### 6. Login active account again after logout on device B - should now succeed
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{activeEmail}}",
  "password": "{{activePassword}}",
  "deviceId": "{{deviceB}}"
}

### Security login for access-control writer endpoints
# @name securityLoginRequest
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{securityRoll}}",
  "password": "{{securityPassword}}",
  "deviceId": "{{securityDevice}}"
}

### Save Token for security user
@securityToken = {{securityLoginRequest.response.body.accessToken}}

### 5. Logout active account from device A
POST {{baseUrl}}/auth/logout
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{securityToken}}",
  "deviceId": "{{securityDevice}}"
}

### Admin login for access audit endpoints
# @name adminLoginRequest
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{adminRoll}}",
  "password": "{{adminPassword}}",
  "deviceId": "{{adminDevice}}"
}

### Save Token for admin user
@adminToken = {{adminLoginRequest.response.body.accessToken}}

### Faculty login for attendance endpoints
# @name facultyLoginRequest
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{facultyRoll}}",
  "password": "{{facultyPassword}}",
  "deviceId": "{{facultyDevice}}"
}

### Save Token for faculty user
@facultyToken = {{facultyLoginRequest.response.body.accessToken}}
@facultyAccountId = {{facultyLoginRequest.response.body.user.id}}

### 7. Device switch active account from device B to device A
POST {{baseUrl}}/auth/device/switch
Content-Type: application/json
Accept: application/json

{
  "studentId": "{{testStudentId}}",
  "oldDeviceId": "{{deviceB}}",
  "newDeviceId": "{{deviceA}}"
}

### Activate pending account
POST {{baseUrl}}/auth/activate
Content-Type: application/json
Accept: application/json

{
  "activationToken": "{{pendingActivationToken}}",
  "password": "{{newActivatedPassword}}"
}

# ==========================================
# PASSWORD RESET FLOWS
# ==========================================

### 1. Request reset token for an existing account
# @name forgotPasswordExisting
POST {{baseUrl}}/auth/password/forgot
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{activeEmail}}"
}

### Store reset token returned for local testing
@passwordResetToken = {{forgotPasswordExisting.response.body.resetToken}}

### After test 2 succeeds, the live password for {{activeEmail}} becomes {{resetPasswordNew}} until changed again.

### 2. Reset password using the generated token
# @name resetPasswordSuccess
POST {{baseUrl}}/auth/password/reset
Content-Type: application/json
Accept: application/json

{
  "resetToken": "{{passwordResetToken}}",
  "newPassword": "{{resetPasswordNew}}"
}

### 3. Login using the new password
# @name loginWithNewPassword
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{activeEmail}}",
  "password": "{{resetPasswordNew}}",
  "deviceId": "{{deviceA}}"
}

### 4. Login using the old password should fail
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{activeEmail}}",
  "password": "{{activePassword}}",
  "deviceId": "{{deviceA}}"
}

### 5. Reuse the same reset token should fail
POST {{baseUrl}}/auth/password/reset
Content-Type: application/json
Accept: application/json

{
  "resetToken": "{{passwordResetToken}}",
  "newPassword": "anotherpassword"
}

### 6. Request reset for a non-existent account
POST {{baseUrl}}/auth/password/forgot
Content-Type: application/json
Accept: application/json

{
  "identifier": "ghost@campus.edu"
}

### 7. Validation error for missing token and short password
POST {{baseUrl}}/auth/password/reset
Content-Type: application/json
Accept: application/json

{
  "resetToken": "",
  "newPassword": "ab"
}

# ==========================================
# PROTECTED ROUTES
# Run these before logout/device-switch/password-reset if you want to keep @authToken valid.
# ==========================================

### Students me placeholder
GET {{baseUrl}}/students/me
Authorization: Bearer {{authToken}}
Accept: application/json

### Student attendance history via the new endpoint
### Expected: 200 OK with a paginated body { data, total, page, pageSize }. Seeded CS21002 should have attendance rows.
# @name studentAttendanceMe
GET {{baseUrl}}/attendance/me
Authorization: Bearer {{authToken}}
Accept: application/json

### Admin lists seeded ABSENT attendance rows to bootstrap dynamic IDs for the faculty tests
### Expected: 200 OK with at least one row. The first row should be Priya's ABSENT record for 2026-04-02 from the seed.
# @name adminAttendanceAbsent
GET {{baseUrl}}/attendance/records?status=ABSENT&page=1&pageSize=10
Authorization: Bearer {{adminToken}}
Accept: application/json

### Faculty views the seeded session summary before changing the record
### Expected: 200 OK. Before the manual update, this should show total: 1, absent: 1, excused: 0 for 2026-04-02.
# @name facultySessionSummaryBefore
GET {{baseUrl}}/attendance/sessions/{{seededAbsentTemplateId}}/summary?scheduledDate={{seededAbsentScheduledDate}}
Authorization: Bearer {{facultyToken}}
Accept: application/json

### Faculty manually changes the seeded ABSENT record to EXCUSED
### Expected: 201 Created with attendance.status = EXCUSED and attendance.method = MANUAL.
# @name facultyManualExcuse
POST {{baseUrl}}/attendance/faculty/mark
Authorization: Bearer {{facultyToken}}
Content-Type: application/json
Accept: application/json

{
  "studentAccountId": "{{seededAbsentStudentId}}",
  "classSessionTemplateId": "{{seededAbsentTemplateId}}",
  "scheduledDate": "{{seededAbsentScheduledDate}}",
  "status": "EXCUSED"
}

### Faculty views the same session summary after the manual update
### Expected: 200 OK. After the update, total should stay 1, absent should drop to 0, and excused should become 1.
# @name facultySessionSummaryAfter
GET {{baseUrl}}/attendance/sessions/{{seededAbsentTemplateId}}/summary?scheduledDate={{seededAbsentScheduledDate}}
Authorization: Bearer {{facultyToken}}
Accept: application/json

### Student tries to list all attendance records
### Expected: 403 Forbidden because /attendance/records is for ADMIN or FACULTY only.
GET {{baseUrl}}/attendance/records?page=1&pageSize=5
Authorization: Bearer {{authToken}}
Accept: application/json

### Student tries to mark attendance for an old seeded session
### Expected: 400 OUTSIDE_ATTENDANCE_WINDOW because the scheduled date is intentionally in the past.
POST {{baseUrl}}/attendance/mark
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "classSessionTemplateId": "{{seededAbsentTemplateId}}",
  "scheduledDate": "{{seededAbsentScheduledDate}}",
  "qrToken": "rest-client-old-session",
  "qrIssuedAt": 9999999999999,
  "geofenceValidated": true
}

### Student tries to mark attendance without geofence validation
### Expected: 400 GEOFENCE_FAILED because geofenceValidated is false.
POST {{baseUrl}}/attendance/mark
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "classSessionTemplateId": "{{seededAbsentTemplateId}}",
  "scheduledDate": "{{seededAbsentScheduledDate}}",
  "qrToken": "rest-client-no-geofence",
  "qrIssuedAt": 9999999999999,
  "geofenceValidated": false
}

### Access check should be forbidden for a student token
POST {{baseUrl}}/access/check
Authorization: Bearer {{authToken}}
Content-Type: application/json
