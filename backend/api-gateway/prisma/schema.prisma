generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
  SECURITY
}

enum AccountStatus {
  PENDING
  ACTIVE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  FAILED
}

enum AccessAction {
  ENTRY
  EXIT
  DENIED
}

enum IncidentStatus {
  OPEN
  ASSIGNED
  RESOLVED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentSource {
  MANUAL
  ACCESS_DENIAL
  ATTENDANCE_FAILURE
}

model Account {
  id                  String             @id @default(uuid())
  rollNumber          String             @unique
  email               String             @unique
  password            String
  role                UserRole           @default(STUDENT)
  status              AccountStatus      @default(PENDING)
  activationToken     String?            @unique
  resetToken          String?            @unique
  resetTokenExpiresAt DateTime?

  sessions            Session[]
  profile             StudentProfile?
  attendanceRecords   AttendanceRecord[]
  accessEvents        AccessEvent[]
  incidents           Incident[]

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  accountId    String
  deviceId     String
  accessToken  String   @unique
  refreshToken String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, deviceId])
  @@map("sessions")
}

model StudentProfile {
  id         String  @id @default(uuid())
  accountId  String  @unique
  firstName  String
  lastName   String
  rfidTag    String? @unique

  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model Geofence {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String
  coordinates Json
  radius      Float?
  isActive    Boolean  @default(true)

  @@map("geofences")
}

model AttendanceRecord {
  id          String           @id @default(uuid())
  accountId   String
  classId     String
  timestamp   DateTime         @default(now())
  status      AttendanceStatus

  account     Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("attendance_records")
}

model AccessEvent {
  id          String       @id @default(uuid())
  accountId   String
  geofenceId  String
  timestamp   DateTime     @default(now())
  action      AccessAction
  reason      String?

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("access_events")
}

model Incident {
  id           String            @id @default(uuid())
  accountId    String
  title        String
  type         String
  description  String
  source       IncidentSource    @default(MANUAL)
  severity     IncidentSeverity  @default(MEDIUM)
  status       IncidentStatus    @default(OPEN)
  assignedTo   String?
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("incidents")
}