generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url is removed from here!
}

// ... keep your enums and models (Account, Session) exactly as they were ...
// 1. Enums for strict type safety across the platform
enum UserRole {
  STUDENT
  ADMIN
  SECURITY
}

enum AccountStatus {
  PENDING
  ACTIVE
}

// 2. The Core Identity Model
model Account {
  id              String        @id @default(uuid())
  rollNumber      String        @unique
  email           String        @unique
  password        String        // Note: We will hash this in the next step
  role            UserRole      @default(STUDENT)
  status          AccountStatus @default(PENDING)
  activationToken String?       @unique
  resetToken      String?       @unique
  resetTokenExpiresAt DateTime?
  
  // Relations
  sessions        Session[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  profile           StudentProfile?   // <-- ADD THIS
  attendanceRecords AttendanceRecord[] // <-- ADD THIS
  accessEvents      AccessEvent[]     // <-- ADD THIS
  incidents       Incident[]

  @@map("accounts") // Renames the table in Postgres to lowercase plural
}

// 3. The Session & Device Binding Model
model Session {
  id           String   @id @default(uuid())
  accountId    String
  deviceId     String
  accessToken  String   @unique
  refreshToken String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  // Relations
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, deviceId]) // Enforces the "One device per account" logic at DB level
  @@map("sessions")
}

// ... (Your existing Account and Session models stay here) ...

// --- PROFILE EXTENSION ---
// Keeps auth (Account) separate from physical student data
model StudentProfile {
  id          String   @id @default(uuid())
  accountId   String   @unique
  firstName   String
  lastName    String
  rfidTag     String?  @unique // For physical gate access
  
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  @@map("student_profiles")
}

// --- LOCATION & PRESENCE (Used by Person 4 & 5) ---
model Geofence {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "Main Gate", "CS Building"
  type        String   // "BUILDING", "CLASSROOM", "PARKING"
  coordinates Json     // Stores Polygon lat/long data
  radius      Float?   // If using circular geofences
  isActive    Boolean  @default(true)

  @@map("geofences")
}

// --- ATTENDANCE (Used by Person 3) ---
model AttendanceRecord {
  id          String   @id @default(uuid())
  accountId   String
  classId     String   // E.g., "CS-101"
  timestamp   DateTime @default(now())
  status      String   // "PRESENT", "LATE", "ABSENT"
  
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("attendance_records")
}

// --- ACCESS CONTROL (Used by Person 5 & 6) ---
model AccessEvent {
  id          String   @id @default(uuid())
  accountId   String
  geofenceId  String
  timestamp   DateTime @default(now())
  action      String   // "ENTRY", "EXIT", "DENIED"
  reason      String?  // E.g., "Out of hours", "Invalid RFID"
  
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Note: We don't strictly relation Geofence here in case geofences are deleted, 
  // but you could add a relation if you prefer strict integrity.

  @@map("access_events")
}

model Incident {
  id          String   @id @default(uuid())
  accountId   String
  type        String
  description String
  status      String   @default("OPEN")
  assignedTo  String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("incidents")
async setResetToken(
    accountId: string,
    token: string,
    expiresAt: Date
  ): Promise<void> {
    await this.prisma.account.update({
      where: { id: accountId },
      data: {
        resetToken: token,
        resetTokenExpiresAt: expiresAt,
      },
    });
  }

  async getAccountByResetToken(token: string): Promise<StudentAccount | null> {
    const account = await this.prisma.account.findFirst({
      where: {
        resetToken: token,
        resetTokenExpiresAt: { gt: new Date() },
      },
    });
    return account ? this.mapAccount(account) : null;
  }

  async resetPassword(token: string, newPassword: string): Promise<void> {
    const saltRounds = 10;
    const hashedPassword = await bcrypt.hash(newPassword, saltRounds);
    await this.prisma.account.updateMany({
      where: {
        resetToken: token,
        resetTokenExpiresAt: { gt: new Date() },
      },
      data: {
        password: hashedPassword,
        resetToken: null,
        resetTokenExpiresAt: null,
      },
    });
  }
}